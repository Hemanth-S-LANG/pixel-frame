# ============================================================
# Cole Studio — .gitignore
# ============================================================

# ---- Environment / Secrets (NEVER commit these) ----
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*

# ---- Node modules ----
node_modules/
frontend/node_modules/
backend/node_modules/

# ---- Next.js build output ----
frontend/.next/
frontend/out/

# ---- Backend compiled output ----
backend/dist/

# ---- TypeScript build info ----
*.tsbuildinfo
frontend/next-env.d.ts

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editor / IDE ----
.vscode/settings.json
.idea/
*.swp
*.swo

# ---- Package manager lock files (keep package-lock.json, ignore others) ----
yarn.lock
pnpm-lock.yaml
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Coverage / Testing ----
coverage/
.nyc_output/

# ---- Vercel / Deployment ----
.vercel

# ---- SSL / Certs ----
*.pem
*.key
*.cert

# ---- AI agent instruction files (internal use only) ----
frontend/AGENTS.md
frontend/CLAUDE.md
